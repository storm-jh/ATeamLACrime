      <aliases enabled='yes' />
      <column caption='Area Name' datatype='string' name='[AREA NAME]' role='dimension' type='nominal' />
      <column caption='Area' datatype='integer' name='[AREA]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Hour Occ' datatype='integer' name='[Calculation_1196831615665508352]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [TIME OCC])' />
      </column>
      <column caption='Vict Age processed' datatype='string' name='[Calculation_1196831616077295619]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Vict Age]&lt;= 0 OR [Vict Age] &gt; 110 THEN &apos;Outlier&apos;&#13;&#10;ELSE &apos;Normal&apos;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Crm Cd Desc]' role='dimension' type='nominal' />
      <column caption='Date Occ' datatype='date' name='[DATE OCC]' role='dimension' type='quantitative' />
      <column caption='Dr No' datatype='integer' name='[DR_NO]' role='measure' type='quantitative' />
      <column aggregation='Avg' datatype='real' name='[LAT]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
